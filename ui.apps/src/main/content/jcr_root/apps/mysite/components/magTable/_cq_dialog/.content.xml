<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Mag Table"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <propertiesTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Mag Table"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <tableTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Heading displayed above the table."
                                fieldLabel="Table Title"
                                name="./tableTitle"/>
                            <tableSubtitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Optional description displayed below the title."
                                fieldLabel="Table Subtitle"
                                name="./tableSubtitle"/>
                            <cfEndpoint
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="GraphQL persisted query endpoint to load table rows from Content Fragments (e.g. /graphql/execute.json/mysite/GetTableItems)."
                                fieldLabel="Content Fragment GraphQL Endpoint"
                                name="./cfEndpoint"/>
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldDescription="Define each column: a machine-readable key (must match the CF field name) and a display label."
                                fieldLabel="Columns">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./columnItem">
                                    <items jcr:primaryType="nt:unstructured">
                                        <key
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldDescription="Machine-readable key matching the Content Fragment field name (e.g. 'price')."
                                            fieldLabel="Column Key"
                                            name="./key"/>
                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldDescription="Human-readable column header text (e.g. 'Price')."
                                            fieldLabel="Column Label"
                                            name="./label"/>
                                    </items>
                                </field>
                            </columns>
                        </items>
                    </propertiesTab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
